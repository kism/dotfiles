#!/usr/bin/env zsh

# Print fstab lines to stop macOS auto-mounting the volumes that trigger the 💾 in .zshrc

found=0
vols=()
uuids=()
# Same source as the 💾 check in .zshrc, so they can't disagree
for vol in ${(f)"$(mount | grep ', local' | grep -v nobrowse | sed -n 's|^.* on \(/Volumes/.*\) (.*$|\1|p')"}; do
    [[ $vol == /Volumes/Recovery ]] && continue
    if diskutil info "$vol" 2>/dev/null | grep -q 'Protocol: *Disk Image'; then
        echo "Skipping $vol, mounted disk image, eject with: diskutil eject \"$vol\"" >&2
        continue
    fi
    uuid=$(diskutil info "$vol" 2>/dev/null | awk -F': *' '/Volume UUID/ {print $2}')
    if [[ -z $uuid ]]; then
        echo "Skipping $vol, no Volume UUID (FAT?): $(mount | grep " on $vol ")" >&2
        continue
    fi
    fs=$(diskutil info "$vol" | awk -F': *' '/Type \(Bundle\)/ {print $2}')
    if (( !found )); then
        echo "Run 'sudo vifs' and add these lines:"
        echo
        found=1
    fi
    echo "UUID=$uuid none $fs rw,noauto # ${vol:t}"
    vols+=("$vol")
    uuids+=("$uuid")
done

# Locked FileVault volumes (e.g. another macOS install) aren't mounted so the loop above misses them,
# but they still trigger an unlock prompt at login
locked=()
for line in ${(f)"$(diskutil apfs list | awk '
    /\+-> Volume/ {uuid = $NF}
    /Name:/ {sub(/^.*Name: */, ""); sub(/ \(Case-.*$/, ""); name = $0}
    /FileVault:.*Locked/ {print uuid " " name}')"}; do
    if (( !found )); then
        echo "Run 'sudo vifs' and add these lines:"
        echo
        found=1
    fi
    echo "UUID=${line%% *} none apfs rw,noauto # ${line#* } (locked)"
    locked+=("$line")
done

if (( !found )); then
    echo "No extra volumes mounted, nothing to ignore"
    exit 0
fi

if (( ${#vols} )); then
    echo
    echo "Then eject them now with:"
    for vol in $vols; do
        echo "  diskutil unmount \"$vol\""
    done
fi
echo
echo "Mount on demand later with:"
for (( i = 1; i <= ${#vols}; i++ )); do
    echo "  diskutil mount $uuids[i] # ${vols[i]:t}"
done
for line in $locked; do
    echo "  diskutil apfs unlockVolume ${line%% *} # ${line#* }"
done
