#!/usr/bin/env python3
"""Extract archives into a folder in the current directory, whatever the format.

Usage: unarchive FILE...

- tar with any compression (gz, bz2, xz, and zst via the zstd command), zip (and jar/whl/apk), 7z, rar.
- The output is a folder named after the archive. If the archive holds exactly one top-level
  folder, you're asked (showing both paths) whether to use that folder as-is instead, which
  avoids foo/foo-1.0 nesting. Enter or no terminal means yes. Not asked when the names match.
- A single compressed file (.gz .bz2 .xz .zst that isn't a tar) is just decompressed, like gunzip -k.
- Never overwrites: if the name is taken, -1, -2, ... is appended.
- Paths or links that would land outside the output folder are refused.
"""

import bz2
import gzip
import lzma
import os
import shutil
import subprocess
import sys
import tarfile
import tempfile
import zipfile
from pathlib import Path

SINGLE_FILE = {".gz": gzip.open, ".bz2": bz2.open, ".xz": lzma.open, ".lzma": lzma.open}


class Refused(Exception):
    pass


def unique(path):
    """Path that doesn't exist yet: path, path-1, path-2, ..."""
    candidate, i = path, 0
    while candidate.exists() or candidate.is_symlink():
        i += 1
        candidate = path.with_name(f"{path.name}-{i}")
    return candidate


def base_name(archive):
    """foo.tar.gz -> foo, foo.tgz -> foo, foo.zip -> foo"""
    stem = Path(archive.name).stem
    if stem.lower().endswith(".tar"):
        stem = stem[:-4]
    return stem or archive.name


def which(*names):
    return next((shutil.which(n) for n in names if shutil.which(n)), None)


def escapes(name):
    return name.startswith("/") or ".." in Path(name).parts


def extract_tar(tf, dest):
    if hasattr(tarfile, "data_filter"):
        try:  # PEP 706: refuses paths/links leaving dest, strips setuid and device files
            tf.extractall(dest, filter="data")
        except tarfile.FilterError as e:
            raise Refused(e) from e
        return
    # Python without PEP 706 (stock macOS 3.9): check each member ourselves, refuse the whole archive on a bad one
    for m in tf:
        if (
            escapes(m.name)
            or ((m.issym() or m.islnk()) and escapes(m.linkname))
            or m.isdev()
        ):
            raise Refused(f"{m.name}: path or link leaves the output folder")
        tf.extract(m, dest)


def extract_zip(archive, dest):
    with zipfile.ZipFile(archive) as zf:
        for info in zf.infolist():
            out = zf.extract(info, dest)  # zipfile already drops absolute paths and ..
            exec_bits = (
                info.external_attr >> 16
            ) & 0o111  # zipfile drops unix modes, keep +x for scripts/binaries
            if exec_bits and not info.is_dir():
                os.chmod(out, os.stat(out).st_mode | exec_bits)


def run_tool(archive, dest, tools, install_hint):
    """tools: [(binary names, argv builder)], first installed one wins"""
    for names, argv in tools:
        binary = which(*names)
        if binary:
            subprocess.run(argv(binary, str(archive), str(dest)), check=True)
            return
    raise Refused(f"no extractor installed, install {install_hint}")


SEVEN_ZIP = (("7zz", "7z", "7za"), lambda b, a, d: [b, "x", "-bso0", f"-o{d}", "--", a])
BSDTAR = (
    ("bsdtar",),
    lambda b, a, d: [b, "-xf", a, "-C", d],
)  # refuses .. and absolute paths by default
UNRAR = (("unrar",), lambda b, a, d: [b, "x", "-idq", "--", a, d + "/"])


def extract_into(archive, dest):
    """Extract archive's contents into the existing empty folder dest."""
    suffix = archive.suffix.lower()
    if zipfile.is_zipfile(archive):
        extract_zip(archive, dest)
    elif tarfile.is_tarfile(archive):  # any compression python reads (zst too on 3.14+)
        with tarfile.open(archive) as tf:
            extract_tar(tf, dest)
    elif suffix in (".zst", ".tzst"):  # tar.zst on python < 3.14
        zstd = which("zstd")
        if not zstd:
            raise Refused("needs zstd, install zstd")
        with subprocess.Popen(
            [zstd, "-dcq", "--", str(archive)], stdout=subprocess.PIPE
        ) as proc:
            with tarfile.open(fileobj=proc.stdout, mode="r|") as tf:
                extract_tar(tf, dest)
        if proc.returncode:
            raise Refused("zstd failed")
    elif suffix == ".7z":
        run_tool(
            archive, dest, [SEVEN_ZIP, BSDTAR], "7zip (or p7zip / libarchive-tools)"
        )
    elif suffix == ".rar":
        run_tool(archive, dest, [UNRAR, SEVEN_ZIP, BSDTAR], "unrar or 7zip")
    else:
        raise Refused("don't know this format")


def decompress_single(archive, cwd):
    """foo.txt.gz -> ./foo.txt, for compressed files that aren't archives"""
    suffix = archive.suffix.lower()
    target = unique(cwd / archive.stem)
    fd, part = tempfile.mkstemp(dir=cwd, prefix=".unarchive-")
    try:
        if suffix == ".zst":
            zstd = which("zstd")
            if not zstd:
                raise Refused("needs zstd, install zstd")
            with os.fdopen(fd, "wb") as out:
                subprocess.run(
                    [zstd, "-dcq", "--", str(archive)], stdout=out, check=True
                )
        else:
            with SINGLE_FILE[suffix](archive) as src, os.fdopen(fd, "wb") as out:
                shutil.copyfileobj(src, out)
        os.chmod(part, 0o666 & ~current_umask())  # mkstemp makes it 0600
        os.rename(part, target)
    except BaseException:
        Path(part).unlink(missing_ok=True)
        raise
    return target


def current_umask():
    mask = os.umask(0)
    os.umask(mask)
    return mask


def use_as_is(archive, folder, cwd, nested):
    """The archive holds one folder: use it as the output, or nest it in a folder named after the archive?"""
    if folder == base_name(archive) or not sys.stdin.isatty():
        return True  # nesting would only give foo/foo, or nobody to ask
    flat = unique(cwd / folder)
    print(f"{archive.name} holds a single folder, {folder}/", file=sys.stderr)
    print(f"  [Y] ./{flat.name}/", file=sys.stderr)
    print(f"  [n] ./{nested.name}/{folder}/", file=sys.stderr)
    sys.stderr.write("Use the folder as-is? [Y/n] ")
    sys.stderr.flush()
    return sys.stdin.readline().strip().lower() not in ("n", "no")  # EOF counts as yes


def unarchive(archive, cwd):
    is_archive = zipfile.is_zipfile(archive) or tarfile.is_tarfile(archive)
    name = archive.name.lower()
    tar_zst = name.endswith((".tar.zst", ".tzst"))
    if (
        not is_archive
        and not tar_zst
        and archive.suffix.lower() in (*SINGLE_FILE, ".zst")
    ):
        return decompress_single(archive, cwd)

    # Extract into a hidden temp folder on the same filesystem, then rename into place
    tmp = Path(tempfile.mkdtemp(dir=cwd, prefix=".unarchive-"))
    try:
        extract_into(archive, tmp)
        entries = list(tmp.iterdir())
        single = (
            len(entries) == 1 and entries[0].is_dir() and not entries[0].is_symlink()
        )
        nested = unique(cwd / base_name(archive))
        if single and use_as_is(archive, entries[0].name, cwd, nested):
            target = unique(cwd / entries[0].name)
            entries[0].rename(target)
            tmp.rmdir()
        else:
            target = nested
            tmp.chmod(0o777 & ~current_umask())  # mkdtemp makes it 0700
            tmp.rename(target)
    except BaseException:
        shutil.rmtree(tmp, ignore_errors=True)
        raise
    return target


def main():
    args = sys.argv[1:]
    if not args or args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if args else 2
    cwd, rc = Path.cwd(), 0
    for arg in args:
        archive = Path(arg)
        try:
            if not archive.is_file():
                raise Refused("not a file")
            target = unarchive(archive.resolve(), cwd)
            print(
                f"{arg} -> {os.path.relpath(target, cwd)}{'/' if target.is_dir() else ''}"
            )
        except (
            Refused,
            OSError,
            EOFError,
            tarfile.TarError,
            zipfile.BadZipFile,
            lzma.LZMAError,
        ) as e:
            print(f"unarchive: {arg}: {e}", file=sys.stderr)
            rc = 1
        except subprocess.CalledProcessError as e:
            print(
                f"unarchive: {arg}: {Path(e.cmd[0]).name} failed (exit {e.returncode})",
                file=sys.stderr,
            )
            rc = 1
    return rc


def main_interruptible():
    try:
        return main()
    except (
        KeyboardInterrupt
    ):  # ctrl-c at the prompt or mid-extract, temp folder is already cleaned up
        print("\nunarchive: aborted", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main_interruptible())
