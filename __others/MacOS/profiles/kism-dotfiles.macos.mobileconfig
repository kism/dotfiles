<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PayloadType</key><string>Configuration</string>
    <key>PayloadVersion</key><integer>1</integer>
    <key>PayloadScope</key><string>User</string>
    <key>PayloadIdentifier</key><string>kism-dotfiles.macos</string>
    <key>PayloadUUID</key><string>8FAD290D-7704-4944-85B6-BF69519D02F6</string>
    <key>PayloadDisplayName</key><string>kism-dotfiles: macOS</string>
    <key>PayloadContent</key>
    <array>
        <dict>
            <key>PayloadType</key><string>com.apple.dock</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>PayloadIdentifier</key><string>kism-dotfiles.macos.com.apple.dock</string>
            <key>PayloadUUID</key><string>5D8291BB-E34D-4D71-995A-06373AB25E68</string>
            <key>orientation</key><string>left</string>
            <key>tilesize</key><integer>46</integer>
            <key>autohide-delay</key><real>0</real>
            <key>autohide-time-modifier</key><real>0</real>
            <key>mineffect</key><string>scale</string>
            <!-- Enable show recent apps (Just for the divider), zero doesn't work -->
            <key>show-recents</key><true/>
            <key>show-recent-count</key><integer>1</integer>
            <key>springboard-columns</key><integer>9</integer>
            <key>springboard-rows</key><integer>9</integer>
            <key>scroll-to-open</key><true/>
            <!-- Mission Control -->
            <key>mru-spaces</key><true/>
            <key>expose-group-apps</key><true/>
        </dict>
        <dict>
            <key>PayloadType</key><string>com.apple.finder</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>PayloadIdentifier</key><string>kism-dotfiles.macos.com.apple.finder</string>
            <key>PayloadUUID</key><string>7A5CCA2B-E426-41CC-BEA8-3B646DF89B29</string>
            <key>ShowPathbar</key><true/>
            <key>FXPreferredViewStyle</key><string>Nlsv</string>
            <key>FXPreferredSearchViewStyle</key><string>Nlsv</string>
            <key>_FXSortFoldersFirst</key><true/>
            <key>FXDefaultSearchScope</key><string>SCcf</string>
            <key>FXRemoveOldTrashItems</key><true/>
        </dict>
        <dict>
            <key>PayloadType</key><string>.GlobalPreferences</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>PayloadIdentifier</key><string>kism-dotfiles.macos.GlobalPreferences</string>
            <key>PayloadUUID</key><string>B5088F2E-A367-467C-9D40-E7750C3BF396</string>
            <key>AppleShowAllExtensions</key><true/>
            <key>NSDocumentSaveNewDocumentsToCloud</key><false/>
        </dict>
        <!-- Don't write .DS_Store files on network drives, external drives -->
        <dict>
            <key>PayloadType</key><string>com.apple.desktopservices</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>PayloadIdentifier</key><string>kism-dotfiles.macos.com.apple.desktopservices</string>
            <key>PayloadUUID</key><string>2206DD79-ACA2-4603-B2DE-50BC3120B844</string>
            <key>DSDontWriteNetworkStores</key><true/>
            <key>DSDontWriteUSBStores</key><true/>
        </dict>
        <dict>
            <key>PayloadType</key><string>com.apple.menuextra.clock</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>PayloadIdentifier</key><string>kism-dotfiles.macos.com.apple.menuextra.clock</string>
            <key>PayloadUUID</key><string>2D324466-D431-412B-B339-9E0C5C30AD1F</string>
            <key>DateFormat</key><string>EEE d MMM HH:mm</string>
        </dict>
        <dict>
            <key>PayloadType</key><string>com.apple.TextEdit</string>
            <key>PayloadVersion</key><integer>1</integer>
            <key>PayloadIdentifier</key><string>kism-dotfiles.macos.com.apple.TextEdit</string>
            <key>PayloadUUID</key><string>79485D9B-899D-4E5C-92D4-75282893F810</string>
            <key>RichText</key><false/>
        </dict>
    </array>
</dict>
</plist>
