# Auto detect text files and perform LF normalization
* text=auto
* text eol=lf
# Handle Windows nonsense ;)
*.ps1    text  eol=crlf
*.psm1   text  eol=crlf
*.psd1   text  eol=crlf
*.psc1   text  eol=crlf
*.ps1xml text  eol=crlf
*.clixml text  eol=crlf
*.xml    text  eol=crlf
# terminfo: binary, keep out of LFS
.terminfo/x/xterm-ghostty -text
.terminfo/g/ghostty -text
